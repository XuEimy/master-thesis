# Engramory live memory store (plain text, machine-local)
/.engramory-memory/

# 本机与临时文件
.DS_Store
__pycache__/
*.pyc
.env
.env.*
!.env.example
/tmp/
/private-materials/

# Local literature source cache; traceable metadata and original URLs remain tracked.
/literature/sources/*
!/literature/sources/crossref/
/literature/data/records.jsonl
/literature/data/文献总库.csv
/literature/data/候选-*.txt

# Registered preprint metadata is small and auditable; candidate snapshots remain local.
!/literature/sources/datacite/
/literature/data/候选-*.json
